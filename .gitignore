# ============================================================
# Secrets — never commit
# ============================================================
.env
.env.local
.env.*.local
*.env
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt
credentials
credentials.*
secrets
secrets.*
.netrc
.smbcreds
*_token*
*_secret*
*_password*
# ...but the guard tests for those rules must stay tracked. Without this
# negation `git add tests/test_no_plaintext_secrets.py` is silently refused
# (it matches `*_secret*`) and the guard disappears from a fresh clone.
!tests/test_*.py
!tests/test_no_*token*.py
!tests/test_no_*password*.py
*.kdbx

